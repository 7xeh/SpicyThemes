{
  "name": "spicy-themes",
  "version": "1.3.7",
  "description": "A Spicetify extension that lets you customize the theme of Spicy Lyrics with colors, effects, fonts, and more!",
  "main": "dist/spicy-themes.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/7xeh/SpicyThemes.git"
  },
  "bugs": {
    "url": "https://github.com/7xeh/SpicyThemes/issues"
  },
  "homepage": "https://github.com/7xeh/SpicyThemes#readme",
  "scripts": {
    "build": "node build.js",
    "rebuild": "node build.js --no-bump",
    "build:watch": "node build.js --watch",
    "deploy": "node deploy.js",
    "redeploy": "node deploy.js --no-bump",
    "reset": "spicetify config extensions spicy-themes.js- && spicetify apply",
    "apply": "spicetify apply",
    "release": "npm run build && copy dist\\spicy-themes.js builds\\spicy-themes.js"
  },
  "keywords": [
    "spicetify",
    "spotify",
    "lyrics",
    "themes",
    "customization",
    "spicy-lyrics",
    "extension"
  ],
  "author": "7xeh",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}